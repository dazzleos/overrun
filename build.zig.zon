            .url = "git+https://github.com/dazzleos/dazzle#280e2d260d6501f4cfe5ccc1025be677e6a30979",
            .hash = "dazzle-0.0.0-ze61IKSO2wCfoi9F6v10IpcC9KCNZA58x1adOh-LVGIf",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
    },
}
